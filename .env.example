# Copy to .env and change the secrets. .env is git-ignored.

# MySQL
DB_NAME=money_management
DB_USER=money
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Port on this machine for DB tools; change it if a local MySQL already uses 3306
DB_HOST_PORT=3306

# API
API_PORT=8080
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_TTL=168h
# release (default) or debug
GIN_MODE=release
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173
