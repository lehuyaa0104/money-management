# Copy to .env and change the secrets. .env is git-ignored.

# MySQL
DB_NAME=money_management
DB_USER=money
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Port on this machine for DB tools; change it if a local MySQL already uses 3306
DB_HOST_PORT=3306
# Managed MySQL (e.g. Aiven): DB_TLS=true, or paste the provider's CA as DB_CA_CERT
# (PEM, verified). Leave both empty for the local container.
DB_TLS=
DB_CA_CERT=

# API
API_PORT=8080
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Access token lifetime; the web app renews it with a refresh token
JWT_TTL=15m
# Signed in for this long after the app was last opened
REFRESH_TTL=720h
# release (default) or debug
GIN_MODE=release
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173
